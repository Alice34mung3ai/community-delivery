# .env.example
# Copy this file to .env and fill in the real values. Do NOT commit your .env with secrets.
# This example includes variables commonly needed to connect an app to Supabase.

# Environment
NODE_ENV=development
PORT=3000

# Supabase (client)
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Supabase (server / elevated privileges)
# KEEP SERVICE_ROLE_KEY SECRET. Only use on trusted servers (not in browser code).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase - Postgres connection string (optional)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:password@db.supabase.co:5432/postgres

# Optional: JWT secret used by Supabase (if you manage custom JWTs)
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional frontend-exposed keys (prefix with NEXT_PUBLIC_ for Next.js or similar)
# Only expose anon keys that are safe for client use
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Notes:
# - Never commit .env with real secrets.
# - For local development you can use the anon key in client code, but never the service role key.
# - For server-side operations that require elevated privileges (creating signed URLs, bypassing RLS), use SUPABASE_SERVICE_ROLE_KEY.
