# .env - development template
# WARNING: Do NOT commit real production secrets here. Replace values before deployment.

NODE_ENV=development
PORT=3000

# Use SQLite for local dev; for production set a proper DATABASE_URL (Postgres/MySQL)
DATABASE_URL="file:./dev.db"

# JWT secret: set a strong random value in production
JWT_SECRET="dev-secret-change-me"

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# CORS allowed origin for local dev (Vite default port is 5173)
CORS_ORIGIN="http://localhost:5173"

# Google GenAI API key (if used)
GOOGLE_GENAI_API_KEY=

# Prisma dev helper: set to true to auto-apply migrations in dev (use with caution)
PRISMA_AUTO_MIGRATE=false
